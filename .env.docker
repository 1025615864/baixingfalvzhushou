# ============================================
# 开发环境 Docker Compose 环境变量配置
# ============================================

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=baixing_dev_2024
POSTGRES_DB=baixing_law

# Redis配置
REDIS_PASSWORD=baixing_redis_2024

# JWT配置 (开发环境使用简单的密钥)
JWT_SECRET_KEY=dev-jwt-secret-key-for-local-testing-only-32chars
ALGORITHM=HS256

# 安全配置 (开发环境)
CSRF_SECRET_KEY=dev-csrf-secret-key-for-local-testing-32chars
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Prometheus配置
METRICS_AUTH_TOKEN=dev-metrics-token-for-local-testing

# CORS配置
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# AI配置 - DeepSeek
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_SERVICE_URL=http://ai-service:8005

# Sentry配置 (开发环境禁用)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0-dev
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# 应用配置
DEBUG=true
ENVIRONMENT=development
VERSION=1.0.0-dev

# Prometheus配置
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8001

# Grafana配置
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# 前端配置
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://backend:8000/ws
VITE_BACKEND_URL=http://backend:8000

# Redis URL (Docker内部)
REDIS_URL=redis://:baixing_redis_2024@redis:6379/0

# 微服务内部通信密钥
INTERNAL_API_KEY=dev-internal-api-key-for-local-testing

# Kafka配置
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
