# ==========================================
# 百姓法律助手 - 本地开发环境变量模板
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 运行密钥生成脚本：bash scripts/generate_secrets.sh
# 3. 将生成的密钥填入下方对应位置
# 4. 不要将 .env 文件提交到 Git 仓库
# ==========================================

# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=baixing_law

# ==========================================
# 安全配置 (Security)
# ==========================================
SECRET_KEY=dev_secret_key_change_me_run_generate_secrets_sh
JWT_SECRET_KEY=dev_jwt_secret_key_change_me_run_generate_secrets_sh
PAYMENT_WEBHOOK_SECRET=dev_payment_webhook_secret_change_me
METRICS_AUTH_TOKEN=dev_metrics_token_change_me

# ==========================================
# 缓存与消息队列 (Redis)
# ==========================================
REDIS_PASSWORD=dev_redis_password_change_me

# ==========================================
# 网络与跨域 (Network & CORS)
# ==========================================
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ==========================================
# 前端构建配置 (Frontend)
# ==========================================
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8000/ws

# ==========================================
# AI 服务配置 (AI Services)
# ==========================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=deepseek-chat

# ==========================================
# 监控配置 (Monitoring)
# ==========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ==========================================
# 环境标识 (Environment)
# ==========================================
ENVIRONMENT=development
VERSION=2.0.0
DEBUG=true
DB_ALLOW_RUNTIME_DDL=1
AI_QUALITY_REDIS_ENABLED=true
AI_QUALITY_REDIS_KEY_PREFIX=ai_quality:
AI_QUALITY_MAX_RECENT_LOGS=1000
AI_QUALITY_TTL_SECONDS=604800
