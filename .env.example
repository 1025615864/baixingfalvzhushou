# ==========================================
# 百姓法律助手 - 本地开发环境变量模板
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 运行密钥生成脚本：bash scripts/generate_secrets.sh
# 3. 将生成的密钥填入下方对应位置
# 4. 不要将 .env 文件提交到 Git 仓库
# ==========================================

# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=baixing_law
DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/baixing_law
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
SQL_ECHO=false
SLOW_QUERY_THRESHOLD_MS=100
DB_ALLOW_RUNTIME_DDL=1

# 微服务独立数据库连接（覆盖 DATABASE_URL，可选）
USER_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/user_service
LEGAL_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/legal_service
NEWS_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/news_service
COMMUNITY_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/community_service
SEARCH_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/search_service
RECOMMENDATION_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/recommendation_service
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/notification_service
ORDER_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/order_service
POINTS_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/points_service
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/knowledge_service
ARCHIVE_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/archive_service
AI_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/ai_service
EMBEDDING_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/embedding_service
PAYMENT_DATABASE_URL=postgresql+asyncpg://postgres:dev_password_change_me@localhost:5433/payment_channel

# ==========================================
# 安全配置 (Security)
# ==========================================
SECRET_KEY=dev_secret_key_change_me_run_generate_secrets_sh
JWT_SECRET_KEY=dev_jwt_secret_key_change_me_run_generate_secrets_sh
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_AUDIENCE=
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=
CSRF_SECRET_KEY=dev_csrf_secret_change_me
CSRF_ENABLED=true
CSRF_TOKEN_EXPIRE_HOURS=24
CSRF_TOKEN_SIZE=32
CARD_ENCRYPTION_KEY=
# CSRF 保护的 HTTP 方法列表（默认 POST,PUT,PATCH,DELETE）
CSRF_PROTECTED_METHODS=POST,PUT,PATCH,DELETE
# CSRF 豁免路径列表（默认登录/注册/刷新令牌接口）
CSRF_EXEMPT_PATHS=/api/auth/login,/api/auth/register,/api/auth/refresh,/api/user/login,/api/user/register,/api/user/logout
# 邮箱重置密码签名密钥（用于生成密码重置 token 的 HMAC 签名）
EMAIL_RESET_SECRET=baixing-reset-secret-key-2026
PAYMENT_WEBHOOK_SECRET=dev_payment_webhook_secret_change_me
METRICS_AUTH_TOKEN=dev_metrics_token_change_me
INTERNAL_API_KEY=dev-internal-api-key

# ==========================================
# 缓存与消息队列 (Redis)
# ==========================================
REDIS_URL=redis://:dev_redis_password_change_me@localhost:16379/0
REDIS_PASSWORD=dev_redis_password_change_me

# ==========================================
# 网络与跨域 (Network & CORS)
# ==========================================
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=

# ==========================================
# 前端构建配置 (Frontend)
# ==========================================
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8000/ws
VITE_BACKEND_URL=http://localhost:8000

# ==========================================
# AI 服务配置 (AI Services)
# ==========================================
# 必填：OpenAI 兼容的 API Key（DeepSeek / OpenAI 等）
OPENAI_API_KEY=sk-your-api-key-here
# API 地址（DeepSeek 使用 https://api.deepseek.com/v1）
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 模型名称（推荐 deepseek-chat 性价比高）
AI_MODEL=deepseek-chat
# AI 回退模型列表（JSON 数组或逗号分隔）
AI_FALLBACK_MODELS=
# 转写专用 API（可选，默认复用 OPENAI_API_KEY）
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_TRANSCRIBE_BASE_URL=
# 二级 LLM（可选，用于复杂推理任务）
SECONDARY_LLM_URL=
SECONDARY_LLM_KEY=
SECONDARY_LLM_MODEL=deepseek-reasoner

# Azure OpenAI（可选，作为备选 AI 提供者）
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_MODEL=

# AI 新闻摘要
NEWS_AI_SUMMARY_ENABLED=false
NEWS_AI_MAX_AGE=7
NEWS_AI_BATCH_SIZE=50
NEWS_AI_MAX_CONCURRENT=5
# LLM 新闻摘要高级配置（启用多 LLM 提供者轮换）
NEWS_AI_SUMMARY_LLM_ENABLED=false
NEWS_AI_SUMMARY_LLM_RESPONSE_FORMAT=text
NEWS_AI_SUMMARY_LLM_PROVIDERS_JSON=[]
NEWS_AI_SUMMARY_LLM_PROVIDER_STRATEGY=random
NEWS_AI_SUMMARY_WRITEBACK_ENABLED=false
NEWS_REVIEW_POLICY_ENABLED=false

# 语音转写
VOICE_TRANSCRIBE_FORCE_ENABLED=false
VOICE_TRANSCRIBE_PROVIDER=auto

# RAG 配置
RAG_LEVEL1_TIMEOUT_MS=500
RAG_LEVEL2_TIMEOUT_MS=2000
RAG_MIN_SIMILARITY=0.75
RAG_TOP_K=5
CHROMA_PERSIST_DIR=./chroma_db

# AI 质量监控
AI_QUALITY_REDIS_ENABLED=true
AI_QUALITY_REDIS_KEY_PREFIX=ai_quality:
AI_QUALITY_MAX_RECENT_LOGS=1000
AI_QUALITY_TTL_SECONDS=604800

# ==========================================
# 语音识别 (Sherpa ASR)
# ==========================================
SHERPA_ASR_ENABLED=false
SHERPA_ASR_MODE=off
SHERPA_ASR_REMOTE_URL=
SHERPA_ONNX_TOKENS=
SHERPA_ONNX_WENET_CTC_MODEL=
SHERPA_ONNX_WHISPER_ENCODER=
SHERPA_ONNX_WHISPER_DECODER=
SHERPA_ONNX_WHISPER_LANGUAGE=
SHERPA_ONNX_WHISPER_TASK=transcribe
SHERPA_ONNX_WHISPER_TAIL_PADDINGS=-1
SHERPA_ONNX_NUM_THREADS=2
SHERPA_ONNX_DECODING_METHOD=greedy_search
SHERPA_ONNX_DEBUG=false
SHERPA_ONNX_SAMPLE_RATE=16000
SHERPA_ONNX_FEATURE_DIM=80

# ==========================================
# 微服务地址 (Service URLs)
# ==========================================
AI_SERVICE_URL=http://localhost:8005
USER_SERVICE_URL=http://localhost:8001
ORDER_SERVICE_URL=http://localhost:8004
NEWS_SERVICE_URL=http://localhost:8006
COMMUNITY_SERVICE_URL=http://localhost:8007
LEGAL_SERVICE_URL=http://localhost:8008
SEARCH_SERVICE_URL=http://localhost:8009
RECOMMENDATION_SERVICE_URL=http://localhost:8010
NOTIFICATION_SERVICE_URL=http://localhost:8011
POINTS_SERVICE_URL=http://localhost:8012
ARCHIVE_SERVICE_URL=http://localhost:8013
PAYMENT_SERVICE_URL=http://localhost:8002
PAYMENT_CHANNEL_SERVICE_URL=http://localhost:8002
EMBEDDING_SERVICE_URL=http://localhost:8003
KNOWLEDGE_SERVICE_URL=http://localhost:8081
BACKEND_URL=http://localhost:8000

# ==========================================
# 支付配置 (Payment)
# ==========================================
# 微信支付
WECHATPAY_MCH_ID=your_mch_id
WECHATPAY_MCH_SERIAL_NO=
WECHATPAY_API_V3_KEY=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_PUBLIC_KEY=
WECHATPAY_CERTIFICATES_URL=https://api.mch.weixin.qq.com/v3/certificates
WECHATPAY_NOTIFY_URL=
WECHATPAY_CERT_REFRESH_ENABLED=false
WECHATPAY_CERT_REFRESH_INTERVAL_SECONDS=86400
# 微信支付回调 IP 白名单（逗号分隔）
WECHATPAY_CALLBACK_IPS=203.205.219.0/24,203.205.220.0/24,203.205.221.0/24,203.205.222.0/24,203.205.223.0/24
# 支付宝
ALIPAY_APP_ID=your_app_id
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
# 支付宝回调 IP 白名单（逗号分隔）
ALIPAY_CALLBACK_IPS=103.52.76.0/24,103.52.77.0/24,110.76.16.0/24,110.76.17.0/24,110.76.18.0/24,110.76.19.0/24,110.76.20.0/24,110.76.21.0/24,110.76.22.0/24,110.76.23.0/24
# IkunPay
IKUNPAY_PID=
IKUNPAY_KEY=
IKUNPAY_GATEWAY_URL=https://ikunpay.com/submit.php
IKUNPAY_NOTIFY_URL=
IKUNPAY_RETURN_URL=
IKUNPAY_DEFAULT_TYPE=
# IkunPay 回调 IP 白名单（逗号分隔）
IKUNPAY_CALLBACK_IPS=

# ==========================================
# 通知配置 (Notification)
# ==========================================
# 邮件 (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@baixinglaw.com
# 短信
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ==========================================
# 监控配置 (Monitoring)
# ==========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
OTEL_EXPORTER_OTLP_ENDPOINT=
MONITORING_DIR=monitoring

# ==========================================
# 关键事件告警 (Critical Events)
# ==========================================
CRITICAL_EVENTS_WEBHOOK_URL=
CRITICAL_EVENTS_WEBHOOK_BEARER=
CRITICAL_EVENTS_WEBHOOK_HEADER_NAME=
CRITICAL_EVENTS_WEBHOOK_HEADER_VALUE=
CRITICAL_EVENTS_TIMEOUT_SECONDS=3.0

# ==========================================
# 对象存储 (S3 / MinIO)
# ==========================================
STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT_URL=http://localhost:9000
STORAGE_S3_BUCKET=baixing-uploads
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_PREFIX=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/baixing-uploads
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==========================================
# 文件上传配置 (Upload)
# ==========================================
UPLOAD_DIR=./uploads
UPLOAD_IMAGE_MODERATION_ENABLED=true
UPLOAD_VIRUS_SCAN_ENABLED=true
UPLOAD_VIRUS_SCAN_FAIL_OPEN=false
UPLOAD_ALLOW_LOCAL_STORAGE=false
# 允许病毒扫描模拟模式（仅开发环境，生产环境必须配置 ClamAV）
UPLOAD_VIRUS_SCAN_ALLOW_MOCK=false

# ==========================================
# 图片审核 (Image Moderation)
# ==========================================
IMAGE_MODERATION_PROVIDER=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_GREEN_ENDPOINT=green.cn-shanghai.aliyuncs.com
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ==========================================
# 向量存储 (Vector Store)
# ==========================================
VECTOR_STORE_TYPE=chroma
EMBEDDING_DIMENSION=768

# ==========================================
# Kafka 事件流
# ==========================================
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ENABLE_KAFKA=false
ENABLE_KAFKA_PRODUCER=false
ENABLE_KAFKA_CONSUMER=false

# ==========================================
# gRPC 配置
# ==========================================
ENABLE_GRPC_SERVER=false
ENABLE_GRPC_CLIENT=false
GRPC_PORT=50051
GRPC_USE_TLS=false

# ==========================================
# 事务与事件 (Saga / Outbox)
# ==========================================
ENABLE_SAGA_PERSISTENCE=false
ENABLE_OUTBOX=true
OUTBOX_POLL_INTERVAL=5

# ==========================================
# 会员管理 (Membership)
# ==========================================
ENABLE_MEMBERSHIP_EXPIRY_CHECK=true

# ==========================================
# 定时任务调度 (Task Scheduler)
# ==========================================
SETTLEMENT_JOB_ENABLED=false
SETTLEMENT_JOB_INTERVAL_SECONDS=3600
REVIEW_TASK_SLA_JOB_ENABLED=false
REVIEW_TASK_SLA_SCAN_INTERVAL_SECONDS=60

# ==========================================
# WebSocket 配置
# ==========================================
WS_MAX_CONNECTIONS_PER_IP=5
WS_MAX_CONNECTIONS_PER_USER=3
WS_MESSAGE_RATE_LIMIT=30
WS_MESSAGE_RATE_WINDOW=60
WS_MAX_MESSAGE_SIZE=10240
WS_CONNECTION_TIMEOUT=300
WS_PING_TIMEOUT=60
WS_MAX_RECONNECT_ATTEMPTS=3
WS_RECONNECT_BACKOFF=5

# ==========================================
# 服务发现 (Consul)
# ==========================================
CONSUL_ENABLED=false
SERVICE_HOST=localhost
SERVICE_PORT=8080

# ==========================================
# 日志脱敏 (Log Masking)
# ==========================================
LOG_MASK_LEVEL=standard
LOG_MASK_DISABLE_IN_DEBUG=true
# 额外的日志脱敏字段列表（逗号分隔，默认已包含 password,secret,token,key,authorization 等）
LOG_MASK_FIELDS=

# ==========================================
# 日志级别 (Log Level)
# ==========================================
LOG_LEVEL=INFO

# ==========================================
# 限流配置 (Rate Limiting)
# ==========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_SECOND=10

# ==========================================
# 环境标识 (Environment)
# ==========================================
ENVIRONMENT=development
APP_ENV=development
# Consul 服务发现注册时使用的环境标签
ENV=development
VERSION=2.0.0
DEBUG=true

# ==========================================
# 内部开关 (Internal Flags)
# ==========================================
ENV_FILE=
_BAIXING_FORCE_VERIFY=

# ==========================================
# 容器资源限制 (Docker Compose Resource Limits)
# ==========================================
# PostgreSQL 数据库
DB_CPU_LIMIT=1
DB_MEMORY_LIMIT=1G
# Redis 缓存
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512M
# 后端服务
BACKEND_CPU_LIMIT=2
BACKEND_MEMORY_LIMIT=2G

# ==========================================
# 端到端测试 (E2E Testing)
# ==========================================
# 设为 1 时自动初始化 E2E 测试种子数据
E2E_SEED=0

# ==========================================
# 冒烟测试配置 (Smoke Test - ikunpay_smoke.py)
# ==========================================
# 冒烟测试后端地址
BACKEND_BASE_URL=http://127.0.0.1:8000
# 测试用普通用户凭据
USER_USERNAME=user1
USER_PASSWORD=user123
# 测试用管理员凭据
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123