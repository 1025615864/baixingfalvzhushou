# JWT RS256 密钥配置示例
# 此文件为示例模板，请复制为 .env.jwt 并填入实际密钥
# 
# 生成命令：
# openssl genrsa -out jwt_private.pem 2048
# openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem

# RSA 私钥（用于签名 token）
# 将 jwt_private.pem 文件内容填入此处
JWT_RSA_PRIVATE_KEY="""
-----BEGIN PRIVATE KEY-----
<your-private-key-here>
-----END PRIVATE KEY-----
"""

# RSA 公钥（用于验证 token）
# 将 jwt_public.pem 文件内容填入此处
JWT_RSA_PUBLIC_KEY="""
-----BEGIN PUBLIC KEY-----
<your-public-key-here>
-----END PUBLIC KEY-----
"""

# JWT 算法配置
JWT_ALGORITHM=RS256
