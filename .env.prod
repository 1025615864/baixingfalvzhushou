# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
# 数据库用户名，默认 postgres
POSTGRES_USER=postgres
# 数据库密码，【生产环境务必修改为强密码】
POSTGRES_PASSWORD=013f4ca29b00f20461b767ac
# 数据库名称
POSTGRES_DB=baixing_law

# ==========================================
# 安全配置 (Security)
# ==========================================
# Flask/FastAPI Session 加密密钥，用于防止 CSRF 等，【务必修改，建议使用 `openssl rand -hex 32` 生成】
SECRET_KEY=4ef5814028cdd3e86ce7360c2ae76226eebf8ac4af89a919276af3ecb399f506418fe1a0cc1b0dd38482afdc0dda56dc
# JWT 签名密钥，用于生成登录 Token，泄露会导致 Token 伪造，【务必修改】
JWT_SECRET_KEY=4ef5814028cdd3e86ce7360c2ae76226eebf8ac4af89a919276af3ecb399f506418fe1a0cc1b0dd38482afdc0dda56dc
# 支付回调签名密钥，用于验证支付平台回调的合法性
PAYMENT_WEBHOOK_SECRET=de4fe718e813c9b4a2a909835ec1773d73ff3f6d1106d26c

# ==========================================
# 缓存与消息队列 (Redis)
# ==========================================
# Redis 连接密码，【务必修改】
REDIS_PASSWORD=5a3b2ba900101d86428f6bec

# ==========================================
# 网络与跨域 (Network & CORS)
# ==========================================
# 允许跨域请求的域名列表（JSON 格式），生产环境应只填写真实域名，如 ["https://your-domain.com"]
CORS_ALLOW_ORIGINS=["http://localhost","http://127.0.0.1"]

# ==========================================
# 前端构建配置 (Frontend)
# ==========================================
# 前端调用后端的 API 基础路径，Docker 部署通过 Nginx 转发通常固定为 /api
VITE_API_BASE_URL=/api

# ==========================================
# AI 服务配置 (AI Services)
# ==========================================
# OpenAI 或兼容接口（如 DeepSeek）的 API Key，【必填】
OPENAI_API_KEY=sk-8661a3e7cb08429a88b1f70fdb1ae580
