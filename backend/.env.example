# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./law_assistant.db

# JWT配置
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI配置 - OpenAI兼容接口
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# 向量数据库配置
CHROMA_PERSIST_DIRECTORY=./chroma_db

# 应用配置
APP_NAME=百姓法律助手
# 生产环境必须设置为 False
DEBUG=False

# ===================
# Security Configuration (生产环境必须配置)
# ===================
# CSRF密钥 - 至少32字符 (openssl rand -hex 32)
CSRF_SECRET_KEY=

# 支付回调密钥 - 至少16字符
PAYMENT_WEBHOOK_SECRET=

# JWT RSA密钥 (生产环境推荐使用RS256)
# 生成命令: openssl genrsa -out private_key.pem 2048 && openssl rsa -in private_key.pem -pubout -out public_key.pem
# 将生成的密钥内容填入下方 (注意保留PEM格式)
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=

# Redis URL (生产环境必须配置)
REDIS_URL=redis://localhost:6379/0

# CORS允许的来源 (生产环境必须配置，多个用逗号分隔)
CORS_ALLOW_ORIGINS=http://localhost:5173

# ===================
# SMS Configuration
# ===================
# 可选：aliyun/tencent/huawei/mock
SMS_PROVIDER=mock

# ===================
# Upload Security Configuration
# ===================
# 生产环境默认禁用mock实现，除非显式允许
UPLOAD_IMAGE_MODERATION_ALLOW_MOCK=false
UPLOAD_VIRUS_SCAN_ALLOW_MOCK=false

# ===================
# Payment Callback Logging
# ===================
# 是否保存原始回调载荷（默认false，仅debug或显式开启）
PAYMENT_CALLBACK_STORE_RAW=false

# ===================
# Sentry Configuration
# ===================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ===================
# Prometheus Configuration
# ===================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8001
# 生产环境必须设置认证令牌 (openssl rand -hex 32)
METRICS_AUTH_TOKEN=

# ===================
# Monitoring Configuration
# ===================
ENVIRONMENT=production
VERSION=1.0.0

# ===================
# Membership Configuration (会员功能)
# ===================
MEMBERSHIP_ENABLED=true
MEMBERSHIP_PRICING_MONTHLY=29
MEMBERSHIP_PRICING_ANNUAL=299
MEMBERSHIP_PRICING_LIFETIME=999

# ===================
# Video Consultation Configuration (视频咨询功能)
# ===================
VIDEO_CONSULTATION_ENABLED=true
VIDEO_CONSULTATION_BASE_FEE=99
TRTC_SDK_ID=your_trtc_sdk_id
TRTC_SDK_KEY=your_trtc_sdk_key

# ===================
# Legal Document Mall Configuration (法律文书商城)
# ===================
LEGAL_DOCUMENT_ENABLED=true
LEGAL_DOCUMENT_INTEGRAL_RATIO=100

# ===================
# Recommendation System Configuration (推荐系统)
# ===================
RECOMMENDATION_ENABLED=true
RECOMMENDATION_CACHE_TTL=3600
