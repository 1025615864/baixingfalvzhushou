# ============================================
# 百姓助手 - 测试环境配置
# ============================================

# --------------------------------------------
# 基础应用配置
# --------------------------------------------
APP_ENV=test
DEBUG=true
TESTING=true

# --------------------------------------------
# 数据库配置 (测试使用 SQLite 内存数据库)
# --------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///:memory:
DATABASE_ECHO=false

# --------------------------------------------
# Redis 配置 (测试使用 Mock)
# --------------------------------------------
REDIS_URL=redis://localhost:6379/1
REDIS_ENABLED=false

# --------------------------------------------
# JWT 配置 (测试专用密钥)
# --------------------------------------------
JWT_SECRET_KEY=test_secret_key_for_unit_tests_only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------
# 支付配置 (测试环境)
# --------------------------------------------
PAYMENT_WEBHOOK_SECRET=test_webhook_secret
WECHAT_PAY_ENABLED=false
ALIPAY_ENABLED=false
PAYMENT_SANDBOX=true

# --------------------------------------------
# 邮件配置 (测试使用 Mock)
# --------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASSWORD=test_password
EMAIL_FROM=test@example.com
EMAIL_ENABLED=false

# --------------------------------------------
# 存储配置 (测试使用本地存储)
# --------------------------------------------
STORAGE_TYPE=local
STORAGE_BASE_PATH=./test_uploads
CDN_BASE_URL=http://localhost:8000/static

# --------------------------------------------
# AI 服务配置 (测试使用 Mock)
# --------------------------------------------
OPENAI_API_KEY=test_openai_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ENABLED=false
DEEPSEEK_API_KEY=test_deepseek_key
DEEPSEEK_ENABLED=false

# --------------------------------------------
# 微信配置 (测试使用 Mock)
# --------------------------------------------
WECHAT_APP_ID=test_wechat_app_id
WECHAT_APP_SECRET=test_wechat_secret
WECHAT_TOKEN=test_wechat_token
WECHAT_ENABLED=false

# --------------------------------------------
# 安全相关配置
# --------------------------------------------
CSRF_SECRET_KEY=test_csrf_secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=false

# --------------------------------------------
# 监控和日志配置 (测试环境禁用)
# --------------------------------------------
SENTRY_DSN=
SENTRY_ENABLED=false
PROMETHEUS_ENABLED=false
LOG_LEVEL=INFO

# --------------------------------------------
# E2E 测试专用配置
# --------------------------------------------
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8000
E2E_TEST_USER_EMAIL=test@example.com
E2E_TEST_USER_PASSWORD=password123
E2E_HEADLESS=true