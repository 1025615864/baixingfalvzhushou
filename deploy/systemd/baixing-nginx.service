[Unit]
Description=Baixing Legal Assistant - Frontend (Nginx)
After=network.target baixing-backend.service

[Service]
Type=simple
User=nginx
Group=nginx

# 启动命令
ExecStartPre=/usr/sbin/nginx -t -c /etc/nginx/nginx.conf
ExecStart=/usr/sbin/nginx -g "daemon off;" -c /etc/nginx/nginx.conf
ExecReload=/bin/kill -HUP $MAINPID

# 重启策略
Restart=always
RestartSec=3

# 资源限制
LimitNOFILE=65536

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baixing-nginx

[Install]
WantedBy=multi-user.target
