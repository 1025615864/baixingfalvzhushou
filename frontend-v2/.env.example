# ============================================
# 百姓助手前端环境变量配置
# ============================================

# ==================== 环境模式 ====================
# 开发: development (默认)
# 生产: production
NODE_ENV=development

# ==================== API 配置 ====================
# API 版本
VITE_API_VERSION=v1

# 基础路径前缀
VITE_API_BASE_URL=/api

# 请求超时（毫秒）
VITE_API_TIMEOUT=30000

# ==================== 微服务端口（开发环境） ====================
# 生产环境通过 API Gateway 统一入口

# 用户服务
VITE_USER_SERVICE_URL=http://localhost:8001

# 支付通道服务
VITE_PAYMENT_SERVICE_URL=http://localhost:8002

# 账务服务
VITE_ACCOUNTING_SERVICE_URL=http://localhost:8003

# 法律服务
VITE_LEGAL_SERVICE_URL=http://localhost:8004

# AI服务
VITE_AI_SERVICE_URL=http://localhost:8005

# 新闻服务
VITE_NEWS_SERVICE_URL=http://localhost:8006

# 社区服务
VITE_COMMUNITY_SERVICE_URL=http://localhost:8007

# 积分服务
VITE_POINTS_SERVICE_URL=http://localhost:8008

# 通知服务
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8009

# 推荐服务
VITE_RECOMMENDATION_SERVICE_URL=http://localhost:8010

# 搜索服务
VITE_SEARCH_SERVICE_URL=http://localhost:8011

# ==================== WebSocket 配置 ====================
VITE_WS_URL=ws://localhost:8000/ws

# ==================== 认证配置 ====================
# Token刷新间隔（毫秒）
VITE_TOKEN_REFRESH_INTERVAL=300000

# 是否启用 Mock 数据
VITE_ENABLE_MOCK=false

# ==================== 功能开关 ====================
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_FORUM=true
VITE_ENABLE_NEWS=true
VITE_ENABLE_POINTS=true

# ==================== 生产环境配置 ====================
# 生产环境使用 API Gateway
# VITE_API_GATEWAY_URL=https://api.example.com
