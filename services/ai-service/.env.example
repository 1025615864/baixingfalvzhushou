# AI服务环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============ 运行环境 ============
ENVIRONMENT=development

# ============ 数据库配置 (PostgreSQL) ============
DATABASE_URL=postgresql+asyncpg://ai_user:your_secure_password@localhost:5432/ai_service
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ============ 知识库/档案库数据库 (用于pgvector) ============
KNOWLEDGE_DATABASE_URL=postgresql://knowledge_user:your_secure_password@localhost:5432/knowledge_service
ARCHIVE_DATABASE_URL=postgresql://archive_user:your_secure_password@localhost:5432/archive_service

# ============ 向量存储类型 ============
# 可选值: chroma (默认, 使用本地ChromaDB), pgvector (使用PostgreSQL pgvector扩展)
VECTOR_STORE_TYPE=chroma

# ============ DeepSeek API 配置 ============
# 【重要】请登录 DeepSeek 控制台获取新的 API Key
# 旧密钥 sk-8661a3e7cb08429a88b1f70fdb1ae580 已泄露，请勿使用
OPENAI_API_KEY=sk-your-new-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ============ 备用 LLM (可选) ============
# SECONDARY_LLM_URL=https://api.openai.com/v1
# SECONDARY_LLM_KEY=sk-your-backup-key
# SECONDARY_LLM_MODEL=gpt-4

# ============ Circuit Breaker ============
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30

# ============ LLM 参数 ============
MAX_TOKENS=2000
TEMPERATURE=0.7

# ============ 服务 URL ============
USER_SERVICE_URL=http://localhost:8001
BACKEND_URL=http://localhost:8000
USE_REMOTE_SESSION=true

# ============ 知识库/档案库服务 (HTTP调用) ============
KNOWLEDGE_SERVICE_URL=http://localhost:8081
ARCHIVE_SERVICE_URL=http://localhost:8082
EMBEDDING_SERVICE_URL=http://localhost:8006

# ============ 内部 API Key (服务间鉴权) ============
# 必须与knowledge-service、archive-service、embedding-service一致
INTERNAL_API_KEY=your-internal-api-key-change-in-production

# ============ RAG 配置 ============
RAG_LEVEL1_TIMEOUT_MS=500
RAG_LEVEL2_TIMEOUT_MS=2000
RAG_MIN_SIMILARITY=0.75

# ============ CORS 配置 ============
# 开发环境允许的前端地址
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============ Redis (可选，用于缓存) ============
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============ Kafka (可选，用于事件驱动) ============
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============ OpenTelemetry (可选，用于分布式追踪) ============
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=ai-service
