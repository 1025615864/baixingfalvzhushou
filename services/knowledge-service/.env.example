# 知识库服务环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============ 运行环境 ============
ENVIRONMENT=development

# ============ 服务配置 ============
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8081

# ============ 数据库配置 (PostgreSQL) ============
KNOWLEDGE_DATABASE_URL=postgresql://knowledge_user:your_secure_password@localhost:5432/knowledge_service

# ============ 向量存储配置 ============
VECTOR_STORE_PATH=./data/chroma_knowledge
EMBEDDING_MODEL=shibing624/text2vec-base-chinese

# ============ 向量存储类型 ============
# 可选值: chroma (默认, 使用本地ChromaDB), pgvector (使用PostgreSQL pgvector扩展)
VECTOR_STORE_TYPE=chroma

# ============ 内部 API Key (服务间鉴权) ============
# 必须与ai-service、embedding-service一致
INTERNAL_API_KEY=your-internal-api-key-change-in-production

# ============ 限流配置 ============
# 搜索接口每分钟最大请求数
SEARCH_RATE_LIMIT=60

# ============ CORS 配置 ============
# 开发环境允许的前端地址
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============ Kafka (可选) ============
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============ OpenTelemetry (可选) ============
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
