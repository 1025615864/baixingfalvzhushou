# 支付通道服务环境变量配置示例
# 复制此文件为 .env 并修改相应值

# ===== 数据库配置 =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payment_channel_service

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379

# ===== Kafka 配置 =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
KAFKA_CONSUMER_GROUP_ID=payment-channel-service-events

# ===== 服务配置 =====
SERVICE_NAME=payment-channel-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8010

# ===== Consul 配置 =====
CONSUL_ENABLED=false
CONSUL_URL=http://localhost:8500

# ===== 依赖服务配置 =====
ORDER_SERVICE_URL=http://localhost:8008

# ===== 认证配置 =====
JWT_SECRET_KEY=your-secret-key-here

# ===== 微信支付配置 =====
WECHAT_PAY_MCH_ID=your-mch-id
WECHAT_PAY_API_KEY=your-wechat-api-key
WECHAT_PAY_CERT_PATH=/app/certs/wechat/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=/app/certs/wechat/apiclient_key.pem

# ===== 支付宝配置 =====
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY_PATH=/app/certs/alipay/app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/app/certs/alipay/alipay_public_key.pem

# ===== 限流配置 =====
RATE_LIMIT_ENABLED=true

# ===== 日志配置 =====
LOG_LEVEL=INFO
ENV=development

# ===== OpenTelemetry 配置 =====
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
