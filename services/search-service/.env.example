# 搜索服务环境变量配置示例
# 复制此文件为 .env 并修改相应值

# ===== 数据库配置 =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/search_service

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379

# ===== Kafka 配置 =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
KAFKA_CONSUMER_GROUP_ID=search-service-events

# ===== 服务配置 =====
SERVICE_NAME=search-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8013

# ===== Consul 配置 =====
CONSUL_ENABLED=false
CONSUL_URL=http://localhost:8500

# ===== 依赖服务配置 =====
USER_SERVICE_URL=http://localhost:8001
LEGAL_SERVICE_URL=http://localhost:8004
COMMUNITY_SERVICE_URL=http://localhost:8003
NEWS_SERVICE_URL=http://localhost:8007
KNOWLEDGE_SERVICE_URL=http://localhost:8006

# ===== 认证配置 =====
JWT_SECRET_KEY=your-secret-key-here

# ===== 搜索配置 =====
SEARCH_RESULTS_PER_TYPE=10
SEARCH_CACHE_TTL=60

# ===== 限流配置 =====
RATE_LIMIT_ENABLED=true

# ===== 日志配置 =====
LOG_LEVEL=INFO
ENV=development

# ===== OpenTelemetry 配置 =====
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
