# ==================== User Service 生产环境配置 ====================
# 请复制此文件为 .env.prod 并修改实际值

# 应用配置
SERVICE_NAME=user-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
DEBUG=false

# JWT 配置 (生产环境必须修改!)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库配置 (PostgreSQL)
USER_DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@db:5433/user_service
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Redis 配置
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=${REDIS_PASSWORD}

# CORS 配置
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Kafka 配置
ENABLE_KAFKA=true
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# gRPC 配置
ENABLE_GRPC_SERVER=true
GRPC_PORT=50051
GRPC_USE_TLS=true
GRPC_TLS_CERT_PATH=/certs/grpc.crt
GRPC_TLS_KEY_PATH=/certs/grpc.key

# 服务注册与发现
CONSUL_ENABLED=true
CONSUL_HOST=consul
CONSUL_PORT=8500

# 监控配置
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
ENABLE_TRACING=true
ENABLE_METRICS=true
